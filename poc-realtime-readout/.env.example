# 복사해서 .env 로 쓰고 값 채우기. .env 는 절대 커밋하지 않는다 (.gitignore 에 있음).
# 키가 없는 API는 건너뛰고 목 데이터가 그 자리를 채운다. `make check-apis` 로 키마다 1회 호출 테스트.

# 네이버 (데이터랩 검색어트렌드 + 블로그 검색)
# 2026-07-31부터 신규 신청은 NAVER API HUB 에서만 가능. HUB 주소·인증 방식이 다르면 아래 URL을 바꾼다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# NAVER_DATALAB_URL=https://openapi.naver.com/v1/datalab/search
# NAVER_SEARCH_URL=https://openapi.naver.com/v1/search/blog.json

# 유튜브 Data API v3 (Google Cloud 프로젝트에서 API 키 발급, 심사 없음)
YOUTUBE_API_KEY=
# 배라 공식 채널 ID (공식/소비자 영상 구분용)
YOUTUBE_OFFICIAL_CHANNEL_ID=

# 인스타그램 Business Discovery (팀 비즈니스 계정 + 연결된 페이스북 페이지 + Meta 앱 토큰)
IG_USER_ID=
IG_ACCESS_TOKEN=
# IG_GRAPH_VERSION=v21.0
# 비교할 공식 계정명, 쉼표로 구분 (배라·요아정·설빙·하겐다즈 — 팀이 확인해서 입력)
IG_ACCOUNTS=
